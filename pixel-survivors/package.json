{
  "name": "pixel-survivors",
  "version": "1.0.0",
  "description": "像素幸存者：类《吸血鬼幸存者》的俯视角像素风肉鸽生存游戏（纯 HTML5 Canvas，无需构建）",
  "private": true,
  "scripts": {
    "start": "npx --yes http-server . -p 8080 -c-1",
    "test": "node tests/ui.test.js && node tests/sim.test.js 1",
    "test:ui": "node tests/ui.test.js",
    "test:sim": "node tests/sim.test.js 1",
    "test:sim:meta": "node tests/sim.test.js 1 1",
    "test:sim:endless": "node tests/sim.test.js 1 0 endless"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
